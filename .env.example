# Copy to .env and fill in. .env is git-ignored - never commit real credentials.

# --- Test accounts (two dedicated Proton accounts, 2FA DISABLED) ---
# Use the full address, e.g. qa.sender@proton.me
PROTON_USERNAME=
PROTON_PASSWORD=
PROTON_RECEIVER_USERNAME=
PROTON_RECEIVER_PASSWORD=

# --- Application URLs ---
BASE_URL=https://proton.me/mail
MAIL_URL=https://mail.proton.me
ACCOUNT_URL=https://account.proton.me

# --- Execution ---
# chromium | firefox | webkit | all
BROWSER=chromium
HEADLESS=true
# Max wait for a message to be delivered to the receiver mailbox (ms)
DELIVERY_TIMEOUT_MS=120000
# Set to true to skip the informational reachability check run before tests
SKIP_PREFLIGHT=false
# debug | info | warn | error
LOG_LEVEL=info
